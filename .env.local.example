# Öffentliche Basis-URL der Website (für Metadata, Canonicals, Sitemap, JSON-LD).
# Kanonische Produktionsdomain. Für lokale Entwicklung kann die Variable
# entfallen; der Code verwendet denselben Produktions-Fallback.
NEXT_PUBLIC_SITE_URL=https://dohome-bau.de

# Supabase – öffentliche (anon) Anbindung der Website an die PMS-Aggregat-Views.
# Werte aus dem Supabase-Dashboard: Project Settings → API.
# Datei nach `.env.local` kopieren (wird von Git ignoriert).
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-KEY

# ---------------------------------------------------------------------------
# Zustellung der Formularanfragen (Resend) – VOR DEM LIVEGANG ZWINGEND SETZEN.
#
# Ohne diese Werte wird KEINE Anfrage zugestellt. Die Formulare melden dann
# bewusst einen Fehler und nennen Telefon und E-Mail, statt Erfolg
# vorzutäuschen – ein still verlorener Lead wäre der teuerste Fehler dieser
# Website. Nach dem Setzen unbedingt eine Testanfrage abschicken.
#
# LEAD_NOTIFY_FROM muss eine bei Resend verifizierte Domain verwenden.
RESEND_API_KEY=re_DEIN_SCHLUESSEL
LEAD_NOTIFY_FROM=DOHOme Website <website@dohome-bau.de>
LEAD_NOTIFY_TO=info@dohome-bau.de
