# Öffentliche Basis-URL der Website (für Metadata, Canonicals, Sitemap, JSON-LD).
# Solange keine Domain feststeht, bleibt der Platzhalter-Default aktiv – bei
# Registrierung hier die echte Domain eintragen (an genau EINER Stelle).
NEXT_PUBLIC_SITE_URL=https://www.dohome.de

# Supabase – öffentliche (anon) Anbindung der Website an die PMS-Aggregat-Views.
# Werte aus dem Supabase-Dashboard: Project Settings → API.
# Datei nach `.env.local` kopieren (wird von Git ignoriert).
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-KEY
