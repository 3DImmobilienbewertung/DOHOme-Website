# Öffentliche Produktions-URL
NEXT_PUBLIC_SITE_URL=

# Optional: Eigentumsbestätigung für Google Search Console und Bing Webmaster
# Tools. Nur den jeweiligen Verifizierungscode eintragen, nicht den kompletten
# Meta-Tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Formularzustellung (serverseitig, niemals NEXT_PUBLIC_ verwenden)
RESEND_API_KEY=
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=

# Optional: Projekt- und Verfügbarkeitsdaten aus Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
